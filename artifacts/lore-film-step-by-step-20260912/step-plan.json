    {
      "id": "quarantine-03-child",
      "mission": "quarantine",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "Тогда уничтожьте оружие и отдайте нам воздух. Почему вы решили похоронить всех?",
      "room": 999,
      "duration": 5.243333333333333,
      "audio": "assets/audio/story/quarantine-03-child.m4a",
      "voice": "child",
