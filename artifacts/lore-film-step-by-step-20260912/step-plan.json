    },
    {
      "id": "nursery-02-gardener",
      "mission": "nursery",
      "kind": "dialogue",
      "speaker": "Садовник",
      "text": "Люди предали доверие. Вы ответили, запретив машинам сострадать.",
      "room": 12,
      "duration": 5.414,
      "audio": "assets/audio/story/nursery-02-gardener.m4a",
      "voice": "gardener",
      "route": "?review=story-radio&cue=nursery-02-gardener&lang=ru&quality=high",
