    {
      "id": "core-03-cathedral",
      "mission": "core",
      "kind": "dialogue",
      "speaker": "Корневой Собор",
      "text": "Операция людей «Голод» отравила три долины. Они хотели вынудить нас открыть ворота.",
      "room": 999,
      "duration": 7.197709750566894,
      "audio": "assets/audio/story/core-03-cathedral.m4a",
      "voice": "robot",
