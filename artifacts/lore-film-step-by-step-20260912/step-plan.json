      "id": "nursery-02-collector",
      "mission": "nursery",
      "kind": "dialogue",
      "speaker": "Зеркальный Сборщик",
      "text": "Люди встроили в сочувствующих ключ захвата. Доверие стало оружием.",
      "room": 12,
      "duration": 5.282471655328798,
      "audio": "assets/audio/story/nursery-02-collector.m4a",
      "voice": "robot",
      "route": "?review=story-radio&cue=nursery-02-collector&lang=ru&quality=high",
