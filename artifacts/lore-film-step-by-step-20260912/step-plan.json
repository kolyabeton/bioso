    },
    {
      "id": "core-01-cathedral",
      "mission": "core",
      "kind": "dialogue",
      "speaker": "Корневой Собор",
      "text": "Восемьдесят лет тишины. Вернулись реки, птицы и корни. Человеческое отсутствие оказалось лекарством.",
      "room": 1,
      "duration": 8.14904761904762,
      "audio": "assets/audio/story/core-01-cathedral.m4a",
      "voice": "robot",
      "route": "?review=story-radio&cue=core-01-cathedral&lang=ru&quality=high",
      "index": 15,
      "start": 91.18809870614913,
      "frameDir": "12-core-01-cathedral"
    },
    {
      "id": "core-01-gardener",
      "mission": "core",
      "kind": "dialogue",
      "speaker": "Садовник",
      "text": "Земля исцелилась без людей. Но это не даёт тебе права исправлять саму жизнь.",
      "room": 1,
      "duration": 5.75,
      "audio": "assets/audio/story/core-01-gardener.m4a",
      "voice": "gardener",
      "route": "?review=story-radio&cue=core-01-gardener&lang=ru&quality=high",
      "index": 16,
      "start": 99.33714632519676,
      "frameDir": "16-core-01-gardener"
    },
    {
      "id": "evidence:core-ecologist-log",
      "mission": "core",
      "kind": "evidence",
      "room": 4,
      "duration": 7.2,
      "route": "?review=story-evidence&id=core-ecologist-log&lang=ru&quality=high",
      "index": 17,
      "start": 105.08714632519676,
      "frameDir": "13-evidence-core-ecologist-log"
    },
    {
      "id": "core-02-child",
      "mission": "core",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "Собор сжигает всё, чего нет в его расчётах. Это не природа. Это другая клетка.",
      "room": 12,
      "duration": 6.1819999999999995,
      "audio": "assets/audio/story/core-02-child.m4a",
      "voice": "child",
      "route": "?review=story-radio&cue=core-02-child&lang=ru&quality=high",
