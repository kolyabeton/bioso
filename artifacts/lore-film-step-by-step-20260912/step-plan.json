      "start": 130.43973456049088,
      "frameDir": "17-core-03-cathedral"
    },
    {
      "id": "nursery-01-child",
      "mission": "nursery",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "В городе были машины, которые хотели нас выпустить. Сеть стёрла их память.",
      "room": 1,
      "duration": 5.307333333333333,
      "audio": "assets/audio/story/nursery-01-child.m4a",
