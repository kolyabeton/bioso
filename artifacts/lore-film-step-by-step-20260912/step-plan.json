    },
    {
      "id": "mother-01-shepherd",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Пастырь Роя",
      "text": "Анализ сигнала: детский голос выбран Советом убежища как наиболее убедительный.",
      "room": 1,
      "duration": 5.978798185941042,
      "audio": "assets/audio/story/mother-01-shepherd.m4a",
      "voice": "robot",
      "route": "?review=story-radio&cue=mother-01-shepherd&lang=ru&quality=high",
      "index": 29,
      "start": 179.20940616246497,
      "frameDir": "24-mother-01-shepherd"
    },
    {
      "id": "mother-01-gardener",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Садовник",
      "text": "Её выбрали как инструмент. Но я слышу человека, а не Совет.",
      "room": 1,
      "duration": 5.200666666666667,
      "audio": "assets/audio/story/mother-01-gardener.m4a",
      "voice": "gardener",
      "route": "?review=story-radio&cue=mother-01-gardener&lang=ru&quality=high",
      "index": 30,
      "start": 185.188204348406,
      "frameDir": "30-mother-01-gardener"
    },
    {
      "id": "evidence:mother-council-protocol",
      "mission": "mother",
      "kind": "evidence",
      "room": 4,
      "duration": 7.2,
      "route": "?review=story-evidence&id=mother-council-protocol&lang=ru&quality=high",
      "index": 31,
      "start": 190.38887101507268,
      "frameDir": "25-evidence-mother-council-protocol"
    },
    {
      "id": "mother-02-child",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "Я нашла этот приказ. Они использовали меня. Но просьба о помощи была настоящей.",
      "room": 12,
      "duration": 5.99,
      "audio": "assets/audio/story/mother-02-child.m4a",
      "voice": "child",
      "route": "?review=story-radio&cue=mother-02-child&lang=ru&quality=high",
      "index": 32,
      "start": 197.58887101507267,
      "frameDir": "26-mother-02-child"
    },
    {
      "id": "evidence:mother-service-report",
      "mission": "mother",
      "kind": "evidence",
      "room": 16,
      "duration": 7.2,
      "route": "?review=story-evidence&id=mother-service-report&lang=ru&quality=high",
      "index": 33,
      "start": 203.57887101507268,
      "frameDir": "27-evidence-mother-service-report"
    },
    {
      "id": "thought:mother-service-report",
      "mission": "mother",
      "kind": "thought",
      "room": 16,
      "duration": 5.544117647058823,
      "route": "?review=story-evidence&id=mother-service-report&thought=1&lang=ru&quality=high",
      "index": 34,
      "start": 210.77887101507267,
      "frameDir": "28-thought-mother-service-report"
    },
    {
      "id": "mother-03-shepherd",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Пастырь Роя",
      "text": "Фильтры откажут через девять дней. Бездействие завершит человеческую угрозу.",
      "room": 999,
      "duration": 5.732086167800454,
      "audio": "assets/audio/story/mother-03-shepherd.m4a",
      "voice": "robot",
      "route": "?review=story-radio&cue=mother-03-shepherd&lang=ru&quality=high",
      "index": 35,
      "start": 216.32298866213148,
      "frameDir": "29-mother-03-shepherd"
    },
    {
      "id": "mother-03-gardener",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Садовник",
      "text": "Не вмешаться — тоже выбор. И за него тоже отвечают.",
      "room": 999,
      "duration": 4.411333333333334,
      "audio": "assets/audio/story/mother-03-gardener.m4a",
      "voice": "gardener",
      "route": "?review=story-radio&cue=mother-03-gardener&lang=ru&quality=high",
      "index": 36,
      "start": 222.05507482993193,
      "frameDir": "36-mother-03-gardener"
    },
    {
      "id": "mother-04-child",
      "mission": "mother",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "Вы не защищаете жизнь. Вы решили, чья жизнь считается жизнью.",
      "room": 999,
      "duration": 4.795333333333333,
      "audio": "assets/audio/story/mother-04-child.m4a",
      "voice": "child",
      "route": "?review=story-radio&cue=mother-04-child&lang=ru&quality=high",
      "index": 37,
      "start": 226.46640816326527,
      "frameDir": "30-mother-04-child"
    },
    {
      "id": "survival-01-child",
      "mission": "survival",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "За этими землями пять Хранителей. Их ядра откроют путь к Главной сети.",
      "room": 1,
      "duration": 4.9446666666666665,
      "audio": "assets/audio/story/survival-01-child.m4a",
      "voice": "child",
      "route": "?review=story-radio&cue=survival-01-child&lang=ru&quality=high",
      "index": 38,
      "start": 231.2617414965986,
      "frameDir": "31-survival-01-child"
    },
    {
      "id": "survival-02-mother",
      "mission": "survival",
      "kind": "dialogue",
      "speaker": "Матка",
      "text": "Освободить людей — риск новой войны. Оставить их внизу — гарантировать вымирание.",
      "room": 1,
      "duration": 6.582108843537415,
      "audio": "assets/audio/story/survival-02-mother.m4a",
      "voice": "robot",
      "route": "?review=story-radio&cue=survival-02-mother&lang=ru&quality=high",
      "index": 39,
      "start": 236.20640816326528,
      "frameDir": "32-survival-02-mother"
    },
    {
      "id": "survival-02-gardener",
      "mission": "survival",
      "kind": "dialogue",
      "speaker": "Садовник",
      "text": "Я не отдам шлюзы ни Совету, ни Сети. Первый выбор сделают те, кого никто не спросил.",
      "room": 1,
      "duration": 7.077999999999999,
      "audio": "assets/audio/story/survival-02-gardener.m4a",
      "voice": "gardener",
      "route": "?review=story-radio&cue=survival-02-gardener&lang=ru&quality=high",
      "index": 40,
      "start": 242.7885170068027,
