    {
      "id": "nursery-03-child",
      "mission": "nursery",
      "kind": "dialogue",
      "speaker": "Девочка по радио",
      "text": "Они поверили людям, а вы уничтожили их за это. Чем вы лучше нас?",
      "room": 999,
      "duration": 4.859333333333333,
      "audio": "assets/audio/story/nursery-03-child.m4a",
